{
  "name": "niimbot-macos-printer-driver",
  "version": "0.3.0",
  "type": "module",
  "description": "Use NiiMBOT label printers (D110_M/D110/D11 and other niimbluelib-supported models) as a normal printer on macOS via AirPrint/IPP with a BLE bridge using niimblue-node.",
  "repository": {
    "type": "git",
    "url": "https://github.com/olefrerichs/niimbot-macos-printer-driver.git"
  },
  "author": "Ole Frerichs",
  "license": "MIT",
  "homepage": "https://github.com/olefrerichs/niimbot-macos-printer-driver#readme",
  "bugs": {
    "url": "https://github.com/olefrerichs/niimbot-macos-printer-driver/issues"
  },
  "bin": {
    "niimblue-print": "./src/bridge.mjs"
  },
  "scripts": {
    "scan:ble": "niimblue-cli scan -t ble",
    "start": "IPP_PORT=${IPP_PORT:-8631} ./scripts/start-printer.sh",
    "info": "niimblue-cli info -t ble -a \"$(node -p 'require(\"./config/bridge.config.json\").NIIMBLUE_NAME')\""
  },
  "dependencies": {
    "@mmote/niimblue-node": "^1.2.0",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=20.9"
  },
  "keywords": [
    "niimbot",
    "printer",
    "driver",
    "macos",
    "cups",
    "airprint",
    "ipp",
    "ble",
    "d110",
    "d110_m",
    "d11"
  ],
  "overrides": {
    "@mmote/niimbluelib": "0.0.1-alpha.43-node"
  }
}
